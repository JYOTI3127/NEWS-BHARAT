Options -MultiViews
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and non-www canonical domain (FIRST - before everything)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^news4bharat\.com$ [NC]
  RewriteRule ^ https://news4bharat.com%{REQUEST_URI} [R=301,L,NE]

  # Sitemap rewrites (AFTER the canonical redirect)
  RewriteRule ^robots\.txt$ robots.txt.php [L]
  RewriteRule ^sitemap\.xml$ sitemap_index.xml.php [L]
  RewriteRule ^sitemap_index\.xml$ sitemap_index.xml.php [L]
  RewriteRule ^(sitemap-[a-z0-9\-]+)\.xml$ $1.xml.php [L]

  RewriteRule ^rss\.xml$ https://news4bharat.cloud/rss.xml [R=301,L]

  # Article URLs should have one canonical version: no trailing slash.
  RewriteCond %{REQUEST_URI} !^/(category|tag|author|news|article|60-seconds|assets|api)(/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/(about-us|about|contact-us|contact|privacy-policy|terms-and-conditions|terms-conditions|terms-of-service|careers|career|newsletter|disclaimer|commingsoon)(/|$) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/$ /$1/$2 [R=301,L,NE,NC]

  # Article HTML proxy: keep news4bharat.com URL, fetch full SEO HTML from backend.
  # Example: /bfsi/article-slug -> /article-proxy.php?category=bfsi&slug=article-slug
  RewriteCond %{REQUEST_URI} !^/(category|tag|author|news|article|60-seconds|assets|api)(/|$) [NC]
  RewriteCond %{REQUEST_URI} !^/(about-us|about|contact-us|contact|privacy-policy|terms-and-conditions|terms-conditions|terms-of-service|careers|career|newsletter|disclaimer|commingsoon)(/|$) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ article-proxy.php?category=$1&slug=$2 [L,QSA,NC]

  # Canonicalize prerendered pages to no trailing slash.
  RewriteCond %{DOCUMENT_ROOT}/__prerender/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # Serve prerendered clean URLs from hidden HTML files.
  # Example: /about-us -> /__prerender/about-us.html
  RewriteCond %{REQUEST_URI} !^/__prerender/ [NC]
  RewriteCond %{DOCUMENT_ROOT}/__prerender/$1.html -f
  RewriteRule ^(.+?)/?$ __prerender/$1.html [L]

  # Existing static files/folders direct serve karo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router support
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # React shell should revalidate so latest deploy loads quickly
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite assets are hashed, so long cache is safe
  <FilesMatch "\.(?:js|mjs|css|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
